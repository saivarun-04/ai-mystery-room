# AI Mystery Room — backend environment

# Port for the Express server (default 3000)
PORT=3000

# MongoDB connection URI (Atlas or local). Required.
MONGODB_URI=mongodb://localhost:27017/ai-mystery-room

# Google Gemini API key. Required for case generation. NEVER commit the real key.
GEMINI_API_KEY=your-gemini-api-key-here

# Origin allowed by CORS (your Vite dev server or deployed frontend).
# Use a comma-separated list for multiple origins.
CLIENT_URL=http://localhost:5173